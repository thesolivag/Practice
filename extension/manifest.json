{
  "manifest_version": 3,
  "name": "SLK Chart Alerts",
  "description": "Create personal SLK Telegram alerts from supported chart pages.",
  "version": "0.1.6",
  "permissions": ["storage"],
  "host_permissions": ["https://slk-backtest-viewer.onrender.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "SLK Chart Alerts", "default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://www.tradingview.com/chart/*", "https://tradingview.com/chart/*", "https://charts.deriv.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
